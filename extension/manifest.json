{
  "manifest_version": 3,
  "name": "Fake Job Detector",
  "version": "2.0.0",
  "description": "Analyzes the job posting on the current page and flags likely scams using an on-device ML model and red-flag rules.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Fake Job Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
